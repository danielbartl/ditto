<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>dev.jbaby.ditto</groupId>
    <artifactId>ditto-parent</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ditto</name>
    <description>Generic comparison of two MongoDB collections</description>
    <url>https://github.com/danielbartl/ditto</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>danielbartl</id>
            <name>Daniel Bartl</name>
            <url>https://github.com/danielbartl</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/danielbartl/ditto</url>
        <connection>scm:git:https://github.com/danielbartl/ditto.git</connection>
        <developerConnection>scm:git:https://github.com/danielbartl/ditto.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/danielbartl/ditto/issues</url>
    </issueManagement>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/danielbartl/ditto</url>
        </repository>
    </distributionManagement>

    <modules>
        <module>ditto-core</module>
        <module>ditto-cli</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Mockito attaches its agent at runtime; allow it without JDK warnings -->
        <argLine>-XX:+EnableDynamicAgentLoading</argLine>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
        <!-- false: upload and validate only, then publish by hand in the Central Portal -->
        <central.autoPublish>true</central.autoPublish>
        <central.waitUntil>published</central.waitUntil>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.jbaby.ditto</groupId>
                <artifactId>ditto-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <compilerArgs>
                            <arg>-Xlint:all,-processing,-serial</arg>
                        </compilerArgs>
                        <!-- resolve annotation processor versions from the Spring Boot BOM -->
                        <annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- unit tests: *Test / *Tests via surefire; integration tests: *IT via failsafe -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- sources, javadoc and signatures, as required by Maven Central; skip signing with -Dgpg.skip -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <doclint>all,-missing</doclint>
                            <quiet>true</quiet>
                            <!-- the default footer says "All rights reserved" -->
                            <bottom>Licensed under the MIT License.</bottom>
                            <groups>
                                <group>
                                    <title>Public API</title>
                                    <packages>dev.jbaby.ditto.comparator:dev.jbaby.ditto.comparator.api:dev.jbaby.ditto.comparator.autoconfigure:dev.jbaby.ditto.comparator.report</packages>
                                </group>
                                <group>
                                    <title>Internal (may change in any release)</title>
                                    <packages>dev.jbaby.ditto.comparator.*</packages>
                                </group>
                            </groups>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- deploy to Maven Central instead of GitHub Packages; use together with the release profile -->
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>${central.autoPublish}</autoPublish>
                            <waitUntil>${central.waitUntil}</waitUntil>
                            <excludeArtifacts>
                                <artifact>ditto-cli</artifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
